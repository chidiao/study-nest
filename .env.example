# Application
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Tencent IM UserSig (fill from Tencent Cloud console; keep the secret server-side)
TENCENT_IM_SDK_APP_ID=
TENCENT_IM_SECRET_KEY=
# Recommended validity is about two months; minimum is 86400 seconds.
TENCENT_IM_USERSIG_EXPIRE_SECONDS=5184000

# MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=study-nest
MYSQL_USER=study-nest
MYSQL_PASSWORD=
MYSQL_PORT=3306

# Prisma connection string
DATABASE_URL=
